# Use the official Node.js image
FROM node:20

WORKDIR /app

COPY package.json yarn.lock ./
COPY .yarnrc.yml ./

# Install dependencies
RUN \
    npm install -g corepack \
    && corepack enable \
    && yarn install

# Expose the port the app runs on
EXPOSE 5173

# The unit suite already runs in lint-test.yml, so serve the app directly
# instead of going through `playwright-local`, which prepends `vitest run`.
CMD ["yarn", "playwright:no-vitest", "--host", "0.0.0.0", "--port", "5173"]
