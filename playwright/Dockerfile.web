# Use the official Node.js image
FROM node:20

WORKDIR /app

COPY package.json yarn.lock ./
COPY .yarnrc.yml ./

# Install dependencies
RUN \
    apt-get update -y \
    && apt-get upgrade -y \
    && npm install -g corepack \
    && corepack enable \
    && yarn install

# Expose the port the app runs on
EXPOSE 5173

# Build the application once, then serve the production bundle to Playwright.
CMD ["sh", "-c", "yarn vitest run && yarn vite build --mode playwright-local && yarn vite preview --host 0.0.0.0 --port 5173 --strictPort"]
